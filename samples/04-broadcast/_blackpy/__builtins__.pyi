"""BlackPy 전용 명령 안내입니다. 이 파일은 실행되지 않습니다.

배경에서 캐릭터 전용 함수는 무시하고 다음 코드를 실행합니다.
캐릭터 전용 상태 값의 읽기·직접 대입은 배경에서 지원하지 않습니다.
"""

from typing import overload as _overload
from typing import Literal as _Literal

이름: str
위치: tuple[float, float]
방향: float
속도: float
크기: float
가시성: bool
배경: str
물리: _Literal["없음", "충돌만", "물리"]
무게: float
닿은_객체_리스트: list[str]


def 말하기(*내용: object, 시간: float | None = None) -> None:
    """값들을 공백으로 이어 표시해요. 시간을 정하면 그 초만큼 말한 뒤 지워요."""


def 앞으로(값: float, /) -> None:
    """일반 이벤트에서는 이동 거리, ~중 이벤트에서는 초당 이동량이에요. 배경에서는 무시해요."""


def 왼쪽으로돌기(값: float, /) -> None:
    """왼쪽으로 돌아요. ~중 이벤트에서는 초당 회전 각도예요. 배경에서는 무시해요."""


def 오른쪽으로돌기(값: float, /) -> None:
    """오른쪽으로 돌아요. ~중 이벤트에서는 초당 회전 각도예요. 배경에서는 무시해요."""


def 왼쪽_돌기(값: float, /) -> None:
    """왼쪽으로 돌아요. ~중 이벤트에서는 초당 회전 각도예요. 배경에서는 무시해요."""


def 오른쪽_돌기(값: float, /) -> None:
    """오른쪽으로 돌아요. ~중 이벤트에서는 초당 회전 각도예요. 배경에서는 무시해요."""


def 뒤집기(축: _Literal["가로", "세로"], /) -> None:
    """모양만 좌우 또는 위아래로 뒤집어요. 같은 축으로 두 번 쓰면 돌아와요. 배경에서는 무시해요."""


def 좌표로(가로: float, 세로: float, /) -> None:
    """지정한 좌표로 즉시 이동해요. 배경에서는 무시해요."""


@_overload
def 바라보기(각도: float, /) -> None:
    """지정한 각도를 바라봐요. 배경에서는 무시해요."""
@_overload
def 바라보기(가로: float, 세로: float, /) -> None:
    """지정한 위치를 바라봐요. 배경에서는 무시해요."""


def 속도_변경(변화량: float, /) -> None:
    """이동·회전 속도 배율에 변화량을 더해요. 배율은 0보다 커야 해요. 배경에서는 무시해요."""


def 물리_설정(모드: _Literal["없음", "충돌만", "물리"], /, 트리거: bool = False) -> None:
    """물리 참여 방식을 정해요. '물리'에서는 중력과 힘이 작용해요. 배경에서는 무시해요."""


def 무게_설정(값: float, /) -> None:
    """무게를 0.001~100000으로 정해요. 같은 힘이면 가벼울수록 더 빨라져요. 배경에서는 무시해요."""


def 힘_작용(각도: float, 크기: float, /) -> None:
    """'물리' 객체를 주어진 각도 방향으로 한 번 밀어요. 오른쪽 0도, 위쪽 90도예요. 배경에서는 무시해요."""


def 정지() -> None:
    """현재 물리 속도를 0으로 만들어요. 이후 중력이나 충돌로 다시 움직일 수 있어요. 배경에서는 무시해요."""


def 크기_바꾸기(변화량: float, /) -> None:
    """현재 크기에 변화량을 더해요. 배경에서는 무시해요."""


def 크기_정하기(배율: float, /) -> None:
    """크기를 0.1~5 사이의 배율로 정해요. 배경에서는 무시해요."""


def 가시성_설정(보임: bool, /) -> None:
    """True면 보이고 False면 숨어요. 배경에서는 무시해요."""


def 기다리기(초: float, /) -> None:
    """지정한 시간 동안 이 이벤트를 기다려요. 다른 이벤트는 계속 실행돼요."""


def 방송하기(신호_이름: str, /) -> None:
    """배경과 캐릭터의 방송_받기 이벤트에 신호를 보내요."""


def 랜덤(부터: int, 까지: int, /) -> int:
    """양 끝을 포함하는 무작위 정수를 구해요."""


def 각도로(가로: float, 세로: float, /) -> float:
    """방향 벡터의 각도를 구해요. 오른쪽은 0도, 위쪽은 90도예요."""


def 이름_정하기(새_이름: str, /) -> None:
    """내 캐릭터의 이름을 바꿔요. 다른 캐릭터와 겹치지 않는 이름을 사용해요. 배경에서는 무시해요."""


def 위치_구하기(대상_이름: str, /) -> tuple[float, float]:
    """이름으로 찾은 캐릭터의 (가로, 세로) 위치를 구해요."""


def 방향_구하기(대상_이름: str, /) -> float:
    """이름으로 찾은 캐릭터의 방향을 구해요."""
